# Copy to .env and fill in your own credentials.
# Never commit the populated .env file.

# --- OpenAI (required) ---
# Used for claim analysis and verdict generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Relative weight given to the model's own judgement when combining
# it with external source verification.
MODEL_WEIGHT=

# --- News and search sources (required for live verification) ---
# NewsAPI (https://newsapi.org) - recent article lookup
NEWS_API_KEY=
GOOGLE_NEWS_API_KEY=

# SerpAPI (https://serpapi.com) - web search fallback
GOOGLE_SERP_API_KEY=

# Google API key used for supplementary lookups
GOOGLE_API_KEY=
